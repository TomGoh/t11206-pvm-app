<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kylinos.xkernelvm.control">

    <!-- Checked by the control service for every caller that is not root or system. -->
    <permission
        android:name="com.kylinos.xkernelvm.permission.CONTROL_VM"
        android:label="@string/permission_label"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.kylinos.xkernelvm.permission.CONTROL_VM" />

    <!-- Checked by the control service's read-only monitoring interface (EL2 cycles per CPU, the
         VM's CPU time), for monitor apps that must not control the VM. Platform-signed and
         allowlisted privileged apps get it; on a development device `pm grant` gives it. -->
    <permission
        android:name="com.kylinos.xkernelvm.permission.READ_VM_STATS"
        android:label="@string/read_stats_permission_label"
        android:protectionLevel="signature|privileged|development" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
