<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kylinos.xkernelvm.control">

    <!-- Checked by the control service for every caller that is not root or system. -->
    <permission
        android:name="com.kylinos.xkernelvm.permission.CONTROL_VM"
        android:label="@string/permission_label"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.kylinos.xkernelvm.permission.CONTROL_VM" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_manage"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
