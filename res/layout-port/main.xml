<?xml version="1.0" encoding="utf-8"?>
<!--
     Portrait: the header, the instance's facts, then the console. While the keyboard is up, or
     the window is too low for both, the facts are hidden (MainActivity.showFacts), so the
     console keeps a usable height.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical">

    <!-- Header: always visible, so the keyboard never takes the state or the controls away. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/state_pill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="16dp">

            <View
                android:id="@+id/state_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/stop"
            style="@style/Button.Secondary"
            android:layout_marginEnd="12dp"
            android:text="@string/stop" />

        <Button
            android:id="@+id/start"
            style="@style/Button.Primary"
            android:text="@string/start" />
    </LinearLayout>

    <!-- Errors and a lost service; hidden otherwise. -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FF991B1B"
            android:textSize="14sp" />

        <Button
            android:id="@+id/reconnect"
            style="@style/Button.Secondary"
            android:layout_marginStart="12dp"
            android:text="@string/reconnect"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- The instance's facts, one row each; scrolls when the keyboard leaves little room. -->
        <ScrollView
            android:id="@+id/details_pane"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginBottom="16dp"
            android:fillViewport="false"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/details_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- The guest's serial console. -->
        <LinearLayout
            android:id="@+id/console_pane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_console"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_console_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <View
                    android:id="@+id/console_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/console_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:textColor="@color/console_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/console_device"
                    android:textColor="@color/console_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/terminal_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fadeScrollbars="false"
                android:scrollbarStyle="outsideOverlay">

                <TextView
                    android:id="@+id/terminal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp"
                    android:textColor="@color/console_text"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </ScrollView>

            <TextView
                android:id="@+id/console_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:textColor="@color/console_note"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Keys above the input line; one row while the keyboard is up (MainActivity). -->
            <LinearLayout
                android:id="@+id/console_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_console_footer"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <HorizontalScrollView
                    android:id="@+id/keys_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/keys"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button android:id="@+id/key_ctrl_c" style="@style/ConsoleKey" android:text="@string/key_ctrl_c" />
                        <Button android:id="@+id/key_tab" style="@style/ConsoleKey" android:text="@string/key_tab" />
                        <Button android:id="@+id/key_up" style="@style/ConsoleKey" android:text="@string/key_up" />
                        <Button android:id="@+id/key_down" style="@style/ConsoleKey" android:text="@string/key_down" />
                        <Button android:id="@+id/key_ctrl_d" style="@style/ConsoleKey" android:text="@string/key_ctrl_d" />
                        <Button android:id="@+id/key_clear" style="@style/ConsoleKey" android:fontFamily="sans-serif" android:text="@string/key_clear" />
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/input_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- A plain ASCII keyboard without composition (visible-password class, force
                         ASCII): a pinyin keyboard would turn shell commands into Chinese. -->
                    <EditText
                        android:id="@+id/input"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:fontFamily="monospace"
                        android:imeOptions="actionSend|flagNoExtractUi|flagNoFullscreen|flagForceAscii"
                        android:importantForAutofill="no"
                        android:inputType="textVisiblePassword|textNoSuggestions"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/console_text"
                        android:textColorHint="@color/console_muted"
                        android:textCursorDrawable="@null"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/send"
                        style="@style/Button.Primary"
                        android:layout_marginStart="10dp"
                        android:minWidth="88dp"
                        android:text="@string/send" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
